# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://recall_atlas:local-dev-only@127.0.0.1:5432/recall_atlas
TEST_DATABASE_URL=postgresql+psycopg2://recall_atlas:local-dev-only@127.0.0.1:5432/recall_atlas_test
FRONTEND_URL=http://127.0.0.1:5173
EMAIL_DEV_MODE=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
MAX_UPLOAD_SIZE_MB=10

# Local development can use the private filesystem adapter. For non-local
# environments, use a private S3-compatible bucket (AWS S3, R2, or MinIO).
STORAGE_BACKEND=local
RECALL_STORAGE_PATH=storage_private
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Malware scanning uses the ClamAV daemon INSTREAM protocol.
# If this is unset or unreachable, uploads stay private in quarantine and are not processed.
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=5

# Durable document worker settings.
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_SECONDS=30
PROCESSING_LEASE_SECONDS=1800
PROCESSING_WORKER_POLL_SECONDS=2

# Optional: set both values to bootstrap a local administrator on API startup.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Development generates an ephemeral CSRF signing key at process start.
# Production must set a unique SECRET_KEY of at least 32 characters.
